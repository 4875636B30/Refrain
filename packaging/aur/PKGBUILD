# Maintainer: <your name> <you@example.com>
#
# The AUR wants a maintainer line with a contact address. Fill this in before
# pushing, or there is nobody to blame when it breaks.

pkgname=refrain-music-bin
pkgver=0.2.0
pkgrel=1
pkgdesc="Fast, low-memory desktop client for YouTube Music"
arch=('x86_64')
url="https://github.com/4875636B30/Refrain"
license=('MIT')

# `alsa-lib` is the only library the binary links beyond glibc; X11, Wayland and
# GL are loaded at runtime by winit and glutin, so they are needed to open a
# window but do not show up in `ldd`.
depends=(
  'alsa-lib'
  'libx11'
  'libxkbcommon'
  'wayland'
  'mesa'
  # Resolves and streams the audio. Nothing plays without it.
  'yt-dlp'
)
optdepends=(
  "quickjs-ng: JavaScript runtime yt-dlp needs to solve YouTube's challenges — playback fails without one, and this is the small one"
  'nodejs: alternative JavaScript runtime'
  'deno: alternative JavaScript runtime'
  'ffmpeg: transcodes a stream the fast path could not use'
)

# No `provides`/`conflicts` for the plain name: `refrain` on the AUR is an
# unrelated package (Discord Rich Presence for Apple Music), so claiming it
# would be both confusing and rude.

source=("${pkgname}-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/refrain-${pkgver}-linux-x86_64.tar.gz")
sha256sums=('463d8caa1c46182ef59a07e3a5045d8b982f191ebffcdb9ee5adc4917ac5e645')

package() {
  local bundle="${srcdir}/refrain-${pkgver}-linux-x86_64"

  install -Dm755 "${bundle}/refrain" "${pkgdir}/usr/bin/refrain"
  install -Dm644 "${bundle}/refrain.desktop" \
    "${pkgdir}/usr/share/applications/refrain.desktop"
  install -Dm644 "${bundle}/refrain.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/refrain.svg"
  # The bundle renames this to match the component id in the file, which is
  # what software centres look the installed name up by.
  install -Dm644 "${bundle}/io.github._4875636B30.Refrain.metainfo.xml" \
    "${pkgdir}/usr/share/metainfo/io.github._4875636B30.Refrain.metainfo.xml"
  install -Dm644 "${bundle}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  # The bundle's own yt-dlp is deliberately not installed: this package depends
  # on the distribution's, which is updated far more often than a release — and
  # the client prefers whichever copy is newer, so the packaged one wins anyway.
}
